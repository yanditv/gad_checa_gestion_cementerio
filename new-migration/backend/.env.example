# =============================================================================
# Base de datos
# =============================================================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cementerio?schema=public"

# =============================================================================
# JWT
# =============================================================================
JWT_SECRET="cementerio-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"
JWT_RESET_EXPIRES_IN="1h"

# =============================================================================
# Frontend
# =============================================================================
FRONTEND_URL="http://localhost:3000"
PORT=3001

# =============================================================================
# SMTP (recuperación de contraseña, notificaciones)
# En dev: usa MailHog → http://localhost:8025
# Si SMTP_HOST está vacío, EmailService entra en modo log-only.
# =============================================================================
SMTP_HOST=""
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE=false
SMTP_FROM="no-reply@gadcheca.gob.ec"

# =============================================================================
# Importación del catastro (Excel histórico)
# =============================================================================
CATASTRO_IMPORT_ENABLED=0
CATASTRO_IMPORT_FORCE=0
CATASTRO_FILE_PATH=./CATASTRO_FINAL.xlsx

# =============================================================================
# GAD & Cementerio Config (Valores Iniciales por Defecto)
# =============================================================================
GAD_NOMBRE="GAD CHECA"
GAD_DIRECCION="Eloy Riera, Parroquia Checa"
GAD_TELEFONO="0987654321"

CEMENTERIO_NOMBRE="Cementerio de Checa"
CEMENTERIO_DIRECCION="Eloy Riera, Parroquia Checa"
CEMENTERIO_TELEFONO="0987654321"
CEMENTERIO_EMAIL="jpcheca0@gmail.com"
CEMENTERIO_PRESIDENTE="Bolívar Robles Iñamagua"
CEMENTERIO_PRESIDENTE_TITULO="Sr."
CEMENTERIO_BANCO_NOMBRE="Banco del Austro"
CEMENTERIO_CUENTA_NUMERO="2000324704"

# =============================================================================
# Storage (documentos firmados, adjuntos)
# Driver soportado actualmente: "local".
# =============================================================================
STORAGE_DRIVER=local
STORAGE_PATH=./storage
