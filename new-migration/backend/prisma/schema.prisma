generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                   String    @id @default(uuid())
  numeroIdentificacion String    @unique
  nombre               String
  apellido             String
  email                String    @unique
  passwordHash         String
  telefono             String?
  direccion            String?
  tipoIdentificacion   String
  estado               Boolean   @default(true)
  mustChangePassword   Boolean   @default(false)
  fechaCreacion        DateTime  @default(now())
  fechaActualizacion   DateTime?

  // Relations (paridad legada — todas las entidades auditadas referencian Usuario)
  personasCreadas      Persona[] @relation("PersonaUsuarioCreador")
  personasActualizadas Persona[] @relation("PersonaUsuarioActualizador")
  personasEliminadas   Persona[] @relation("PersonaUsuarioEliminador")

  difuntos             Difunto[] @relation("DifuntoUsuarioCreador")
  difuntosActualizados Difunto[] @relation("DifuntoUsuarioActualizador")
  difuntosEliminados   Difunto[] @relation("DifuntoUsuarioEliminador")

  contratos             Contrato[] @relation("ContratoUsuarioCreador")
  contratosActualizados Contrato[] @relation("ContratoUsuarioActualizador")
  contratosEliminados   Contrato[] @relation("ContratoUsuarioEliminador")

  descuentos             Descuento[] @relation("DescuentoUsuarioCreador")
  descuentosActualizados Descuento[] @relation("DescuentoUsuarioActualizador")
  descuentosEliminados   Descuento[] @relation("DescuentoUsuarioEliminador")

  bloques             Bloque[] @relation("BloqueUsuarioCreador")
  bloquesActualizados Bloque[] @relation("BloqueUsuarioActualizador")
  bloquesEliminados   Bloque[] @relation("BloqueUsuarioEliminador")

  cementerios             Cementerio[] @relation("CementerioUsuarioCreador")
  cementeriosActualizados Cementerio[] @relation("CementerioUsuarioActualizador")
  cementeriosEliminados   Cementerio[] @relation("CementerioUsuarioEliminador")

  bovedas             Boveda[] @relation("BovedaUsuarioCreador")
  bovedasActualizadas Boveda[] @relation("BovedaUsuarioActualizador")
  bovedasEliminadas   Boveda[] @relation("BovedaUsuarioEliminador")

  pagosCreados      Pago[] @relation("PagoUsuarioCreador")
  pagosActualizados Pago[] @relation("PagoUsuarioActualizador")
  pagosEliminados   Pago[] @relation("PagoUsuarioEliminador")

  gadInformacionesCreadas      GADInformacion[] @relation("GADUsuarioCreador")
  gadInformacionesActualizadas GADInformacion[] @relation("GADUsuarioActualizador")

  documentosSubidos   Documento[]
  notificaciones      Notificacion[]
  catastrosImportados CatastroImport[]

  // Inventario de Bienes Institucionales (TDR Módulo 1)
  categoriasBienCreadas      CategoriaBien[] @relation("CategoriaBienUsuarioCreador")
  categoriasBienActualizadas CategoriaBien[] @relation("CategoriaBienUsuarioActualizador")
  categoriasBienEliminadas   CategoriaBien[] @relation("CategoriaBienUsuarioEliminador")

  custodiosCreados      Custodio[] @relation("CustodioUsuarioCreador")
  custodiosActualizados Custodio[] @relation("CustodioUsuarioActualizador")
  custodiosEliminados   Custodio[] @relation("CustodioUsuarioEliminador")

  bienesCreados      Bien[] @relation("BienUsuarioCreador")
  bienesActualizados Bien[] @relation("BienUsuarioActualizador")
  bienesEliminados   Bien[] @relation("BienUsuarioEliminador")

  movimientosBienRegistrados MovimientoBien[] @relation("MovimientoBienUsuarioCreador")

  usuarioRols UsuarioRol[]
}

model Rol {
  id                String  @id @default(uuid())
  nombre            String  @unique
  nombreNormalizado String  @unique
  concurrencyStamp  String?
  permisos          String?

  usuarios UsuarioRol[]
}

model UsuarioRol {
  usuarioId String
  rolId     String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  rol       Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)

  @@id([usuarioId, rolId])
}

// =============================================================================
// Cementerio + parámetros operativos (paridad con CementerioModel.cs legado)
// =============================================================================
model Cementerio {
  id        Int     @id @default(autoincrement())
  nombre    String
  direccion String?
  telefono  String?
  email     String?
  ruc       String?

  // Datos del representante para PDFs oficiales
  abreviaturaTituloPresidente String? // ej. "Sr.", "Dr."
  presidente                  String?

  // Política de arriendo (años de duración por defecto y máximo de renovaciones)
  vecesRenovacionBovedas Int @default(1)
  vecesRenovacionNicho   Int @default(1)
  aniosArriendoBovedas   Int @default(5)
  aniosArriendoNicho     Int @default(5)

  // Tarifas por defecto al crear contratos (sobrescribibles por bóveda)
  tarifaArriendo      Decimal? @db.Decimal(18, 2)
  tarifaArriendoNicho Decimal? @db.Decimal(18, 2)

  // Datos para depósito/transferencia de pagos
  entidadFinanciera       String?
  nombreEntidadFinanciera String?
  numeroCuenta            String?

  // Mora: porcentaje diario aplicado a cuotas vencidas (mejora [M])
  tasaMoraDiaria Decimal @default(0) @db.Decimal(5, 4)

  estado             Boolean   @default(true)
  fechaCreacion      DateTime  @default(now())
  fechaActualizacion DateTime?
  fechaEliminacion   DateTime?

  usuarioCreadorId      String?
  usuarioCreador        Usuario? @relation("CementerioUsuarioCreador", fields: [usuarioCreadorId], references: [id])
  usuarioActualizadorId String?
  usuarioActualizador   Usuario? @relation("CementerioUsuarioActualizador", fields: [usuarioActualizadorId], references: [id])
  usuarioEliminadorId   String?
  usuarioEliminador     Usuario? @relation("CementerioUsuarioEliminador", fields: [usuarioEliminadorId], references: [id])

  bloques Bloque[]
}

// Datos institucionales del GAD para encabezados de PDF y página About
model GADInformacion {
  id        Int     @id @default(autoincrement())
  nombre    String
  direccion String
  telefono  String
  email     String
  ruc       String
  logo      String?
  logoUrl   String?
  website   String?
  mision    String?
  vision    String?
  slogan    String?

  fechaCreacion      DateTime  @default(now())
  fechaActualizacion DateTime?

  usuarioCreadorId      String?
  usuarioCreador        Usuario? @relation("GADUsuarioCreador", fields: [usuarioCreadorId], references: [id])
  usuarioActualizadorId String?
  usuarioActualizador   Usuario? @relation("GADUsuarioActualizador", fields: [usuarioActualizadorId], references: [id])
}

model Bloque {
  id            Int      @id @default(autoincrement())
  nombre        String
  descripcion   String?
  estado        Boolean  @default(true)
  fechaCreacion DateTime @default(now())

  cementerioId Int
  cementerio   Cementerio @relation(fields: [cementerioId], references: [id])

  usuarioCreadorId      String?
  usuarioCreador        Usuario? @relation("BloqueUsuarioCreador", fields: [usuarioCreadorId], references: [id])
  usuarioActualizadorId String?
  usuarioActualizador   Usuario? @relation("BloqueUsuarioActualizador", fields: [usuarioActualizadorId], references: [id])
  usuarioEliminadorId   String?
  usuarioEliminador     Usuario? @relation("BloqueUsuarioEliminador", fields: [usuarioEliminadorId], references: [id])

  pisos   Piso[]
  bovedas Boveda[]
}

model Piso {
  id          Int     @id @default(autoincrement())
  numero      Int
  descripcion String?
  estado      Boolean @default(true)

  bloqueId Int
  bloque   Bloque @relation(fields: [bloqueId], references: [id])

  bovedas Boveda[]
}

model Boveda {
  id                  Int      @id @default(autoincrement())
  numero              String
  capacidad           Int
  tipo                String?
  estado              Boolean  @default(true)
  observaciones       String?
  ubicacion           String?
  precio              Decimal  @db.Decimal(18, 2)
  precioArrendamiento Decimal  @db.Decimal(18, 2)
  fechaCreacion       DateTime @default(now())

  bloqueId Int
  bloque   Bloque @relation(fields: [bloqueId], references: [id])
  pisoId   Int?
  piso     Piso?  @relation(fields: [pisoId], references: [id])

  propietarioId Int?
  propietario   Propietario? @relation(fields: [propietarioId], references: [id])

  usuarioCreadorId      String?
  usuarioCreador        Usuario? @relation("BovedaUsuarioCreador", fields: [usuarioCreadorId], references: [id])
  usuarioActualizadorId String?
  usuarioActualizador   Usuario? @relation("BovedaUsuarioActualizador", fields: [usuarioActualizadorId], references: [id])
  usuarioEliminadorId   String?
  usuarioEliminador     Usuario? @relation("BovedaUsuarioEliminador", fields: [usuarioEliminadorId], references: [id])

  contratos Contrato[]
  difuntos  Difunto[]
}

// =============================================================================
// Personas (responsables, propietarios)
// =============================================================================
model Persona {
  id                   Int       @id @default(autoincrement())
  numeroIdentificacion String
  nombre               String
  apellido             String
  telefono             String?
  email                String?
  direccion            String?
  tipoIdentificacion   String
  fechaNacimiento      DateTime?
  genero               String?
  estadoCivil          String?
  profesion            String?
  nacionalidad         String?
  estado               Boolean   @default(true)
  fechaCreacion        DateTime  @default(now())
  fechaActualizacion   DateTime?
  fechaEliminacion     DateTime?
  tipoPersona          String    @default("Persona")

  usuarioCreadorId      String?
  usuarioCreador        Usuario? @relation("PersonaUsuarioCreador", fields: [usuarioCreadorId], references: [id])
  usuarioActualizadorId String?
  usuarioActualizador   Usuario? @relation("PersonaUsuarioActualizador", fields: [usuarioActualizadorId], references: [id])
  usuarioEliminadorId   String?
  usuarioEliminador     Usuario? @relation("PersonaUsuarioEliminador", fields: [usuarioEliminadorId], references: [id])

  // Discriminator for inheritance (paridad con TipoPersona del legado)
  responsables Responsable[]
  propietarios Propietario[]

  @@unique([numeroIdentificacion, tipoPersona])
}

model Propietario {
  id            Int      @id @default(autoincrement())
  estado        Boolean  @default(true)
  fechaCreacion DateTime @default(now())

  personaId Int
  persona   Persona @relation(fields: [personaId], references: [id])

  bovedas     Boveda[]
  responsable Responsable?
}

model Responsable {
  id            Int      @id @default(autoincrement())
  parentesco    String?
  estado        Boolean  @default(true)
  fechaCreacion DateTime @default(now())

  personaId Int
  persona   Persona @relation(fields: [personaId], references: [id])

  propietarioId Int?         @unique
  propietario   Propietario? @relation(fields: [propietarioId], references: [id])

  contratoResponsables ContratoResponsable[]
}

// =============================================================================
// Difunto — datos vitales y certificado de defunción (paridad manual usuario §5)
// =============================================================================
model Difunto {
  id                   Int       @id @default(autoincrement())
  nombre               String
  apellido             String
  numeroIdentificacion String?
  fechaNacimiento      DateTime?
  fechaDefuncion       DateTime?
  fechaInhumacion      DateTime?
  causaMuerte          String?
  observaciones        String?
  edad                 Int?
  genero               String?

  // Información complementaria (manual de usuario §5)
  nacionalidad    String?
  estadoCivil     String?
  lugarNacimiento String?
  lugarDefuncion  String?
  nombreConyuge   String?
  nombrePadre     String?
  nombreMadre     String?

  // Certificado de defunción
  numeroCertificadoDefuncion String?
  entidadEmisora             String?
  fechaEmisionCertificado    DateTime?

  estado        Boolean  @default(true)
  fechaCreacion DateTime @default(now())

  bovedaId Int
  boveda   Boveda @relation(fields: [bovedaId], references: [id])

  usuarioCreadorId      String?
  usuarioCreador        Usuario? @relation("DifuntoUsuarioCreador", fields: [usuarioCreadorId], references: [id])
  usuarioActualizadorId String?
  usuarioActualizador   Usuario? @relation("DifuntoUsuarioActualizador", fields: [usuarioActualizadorId], references: [id])
  usuarioEliminadorId   String?
  usuarioEliminador     Usuario? @relation("DifuntoUsuarioEliminador", fields: [usuarioEliminadorId], references: [id])

  contratos Contrato[]
}

// =============================================================================
// Contrato — corazón del dominio
// =============================================================================
model Contrato {
  id                   Int       @id @default(autoincrement())
  numeroSecuencial     String    @unique
  fechaInicio          DateTime
  fechaFin             DateTime?
  numeroDeMeses        Int
  montoSubtotal        Decimal?  @db.Decimal(18, 2)
  montoDescuento       Decimal?  @db.Decimal(18, 2)
  montoTotal           Decimal   @db.Decimal(18, 2)
  estado               Boolean   @default(true)
  observaciones        String?
  esRenovacion         Boolean   @default(false)
  vecesRenovado        Int       @default(0)
  pathDocumentoFirmado String?
  fechaCreacion        DateTime  @default(now())
  fechaActualizacion   DateTime?
  fechaEliminacion     DateTime?

  bovedaId Int
  boveda   Boveda @relation(fields: [bovedaId], references: [id])

  difuntoId Int
  difunto   Difunto @relation(fields: [difuntoId], references: [id])

  descuentoId Int?
  descuento   Descuento? @relation(fields: [descuentoId], references: [id])

  contratoOrigenId Int?
  contratoOrigen   Contrato?  @relation("ContratoOrigen", fields: [contratoOrigenId], references: [id])
  contratosHijos   Contrato[] @relation("ContratoOrigen")

  contratoRelacionadoId Int?
  contratoRelacionado   Contrato?  @relation("ContratoRelacionado", fields: [contratoRelacionadoId], references: [id])
  contratosRelacionados Contrato[] @relation("ContratoRelacionado")

  usuarioCreadorId      String?
  usuarioCreador        Usuario? @relation("ContratoUsuarioCreador", fields: [usuarioCreadorId], references: [id])
  usuarioActualizadorId String?
  usuarioActualizador   Usuario? @relation("ContratoUsuarioActualizador", fields: [usuarioActualizadorId], references: [id])
  usuarioEliminadorId   String?
  usuarioEliminador     Usuario? @relation("ContratoUsuarioEliminador", fields: [usuarioEliminadorId], references: [id])

  responsables ContratoResponsable[]
  cuotas       Cuota[]
  documentos   Documento[]
}

model ContratoResponsable {
  contratoId    Int
  responsableId Int
  contrato      Contrato    @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  responsable   Responsable @relation(fields: [responsableId], references: [id])

  @@id([contratoId, responsableId])
}

model Cuota {
  id               Int       @id @default(autoincrement())
  numero           Int
  monto            Decimal   @db.Decimal(18, 2)
  fechaVencimiento DateTime
  fechaPago        DateTime?
  pagada           Boolean   @default(false)
  intereses        Decimal   @default(0) @db.Decimal(18, 2)
  estado           Boolean   @default(true)
  observaciones    String?

  contratoId Int
  contrato   Contrato @relation(fields: [contratoId], references: [id])

  pagos CuotaPago[]
}

// =============================================================================
// Pago — recibo emitido al cobrar 1..N cuotas
// =============================================================================
model Pago {
  id             Int      @id @default(autoincrement())
  numeroRecibo   String   @unique
  monto          Decimal  @db.Decimal(18, 2)
  montoSubtotal  Decimal? @db.Decimal(18, 2)
  montoDescuento Decimal? @db.Decimal(18, 2)
  fechaPago      DateTime
  metodoPago     String
  referencia     String?
  observacion    String?
  estado         Boolean  @default(true)

  fechaCreacion      DateTime  @default(now())
  fechaActualizacion DateTime?
  fechaEliminacion   DateTime?

  bancoId Int?
  banco   Banco? @relation(fields: [bancoId], references: [id])

  descuentoId Int?
  descuento   Descuento? @relation(fields: [descuentoId], references: [id])

  usuarioCreadorId      String?
  usuarioCreador        Usuario? @relation("PagoUsuarioCreador", fields: [usuarioCreadorId], references: [id])
  usuarioActualizadorId String?
  usuarioActualizador   Usuario? @relation("PagoUsuarioActualizador", fields: [usuarioActualizadorId], references: [id])
  usuarioEliminadorId   String?
  usuarioEliminador     Usuario? @relation("PagoUsuarioEliminador", fields: [usuarioEliminadorId], references: [id])

  cuotas CuotaPago[]
}

model CuotaPago {
  cuotaId Int
  pagoId  Int
  cuota   Cuota @relation(fields: [cuotaId], references: [id])
  pago    Pago  @relation(fields: [pagoId], references: [id], onDelete: Cascade)

  @@id([cuotaId, pagoId])
}

model Descuento {
  id            Int       @id @default(autoincrement())
  nombre        String
  porcentaje    Decimal   @db.Decimal(5, 2)
  descripcion   String?
  estado        Boolean   @default(true)
  fechaInicio   DateTime  @default(now())
  fechaFin      DateTime?
  fechaCreacion DateTime  @default(now())

  usuarioCreadorId      String?
  usuarioCreador        Usuario? @relation("DescuentoUsuarioCreador", fields: [usuarioCreadorId], references: [id])
  usuarioActualizadorId String?
  usuarioActualizador   Usuario? @relation("DescuentoUsuarioActualizador", fields: [usuarioActualizadorId], references: [id])
  usuarioEliminadorId   String?
  usuarioEliminador     Usuario? @relation("DescuentoUsuarioEliminador", fields: [usuarioEliminadorId], references: [id])

  contratos Contrato[]
  pagos     Pago[]
}

model Banco {
  id            Int      @id @default(autoincrement())
  nombre        String   @unique
  cuenta        String?
  estado        Boolean  @default(true)
  fechaCreacion DateTime @default(now())

  pagos Pago[]
}

// =============================================================================
// Documentos firmados (PDF escaneado del contrato y otros)
// =============================================================================
model Documento {
  id             Int      @id @default(autoincrement())
  contratoId     Int
  contrato       Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  storageKey     String // path local o key S3 (no URL pública)
  nombreOriginal String
  mimeType       String
  tamanioBytes   Int
  tipo           String   @default("ContratoFirmado") // "ContratoFirmado" | "CedulaResponsable" | "Otro"
  estado         Boolean  @default(true)
  fechaCreacion  DateTime @default(now())

  subidoPorId String?
  subidoPor   Usuario? @relation(fields: [subidoPorId], references: [id])

  @@index([contratoId])
}

// =============================================================================
// Notificaciones por usuario (header dropdown + página /notify + email)
// =============================================================================
model Notificacion {
  id        Int     @id @default(autoincrement())
  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  tipo        String // "ContratoPorVencer" | "ContratoVencido" | "CuotaVencida" | "PagoRegistrado" | "Generico"
  titulo      String
  mensaje     String
  entidadTipo String? // "Contrato" | "Cuota" | "Pago" | "Boveda" | ...
  entidadId   Int?

  leida         Boolean   @default(false)
  fechaLectura  DateTime?
  fechaCreacion DateTime  @default(now())

  @@index([usuarioId, leida])
  @@index([fechaCreacion])
}

// =============================================================================
// Importación de catastro on-demand (Fase 9.2)
// Log persistido por cada subida de Excel para auditoría y vista de estado.
// =============================================================================
model CatastroImport {
  id                  Int       @id @default(autoincrement())
  filename            String
  estado              String    @default("EN_PROGRESO") // EN_PROGRESO | COMPLETADO | ERROR
  registrosProcesados Int       @default(0)
  bloquesCreados      Int       @default(0)
  bovedasCreadas      Int       @default(0)
  contratosCreados    Int       @default(0)
  errores             String? // JSON con la lista de errores (máx 100)
  mensajeError        String? // sólo si estado=ERROR (excepción global)
  fechaInicio         DateTime  @default(now())
  fechaFin            DateTime?

  adminUserId String
  adminUser   Usuario @relation(fields: [adminUserId], references: [id])

  @@index([fechaInicio])
}

// =============================================================================
// Inventario de Bienes Institucionales (TDR El Valle — Módulo 1)
// Anclado a Normas de Control Interno CGE 406-01 (PPE) y 406-03 (depreciación).
// =============================================================================

// Catálogo de categorías de activo con su vida útil y % de valor residual.
model CategoriaBien {
  id                 Int       @id @default(autoincrement())
  nombre             String // ej. "Equipo informático", "Mueble y enser"
  vidaUtilAnios      Int // tabla CGE 406-03
  valorResidualPct   Decimal   @default(10) @db.Decimal(5, 2)
  estado             Boolean   @default(true)
  fechaCreacion      DateTime  @default(now())
  fechaActualizacion DateTime?
  fechaEliminacion   DateTime?

  usuarioCreadorId      String?
  usuarioCreador        Usuario? @relation("CategoriaBienUsuarioCreador", fields: [usuarioCreadorId], references: [id])
  usuarioActualizadorId String?
  usuarioActualizador   Usuario? @relation("CategoriaBienUsuarioActualizador", fields: [usuarioActualizadorId], references: [id])
  usuarioEliminadorId   String?
  usuarioEliminador     Usuario? @relation("CategoriaBienUsuarioEliminador", fields: [usuarioEliminadorId], references: [id])

  bienes Bien[]
}

// Custodio responsable de los bienes (funcionario del GAD).
model Custodio {
  id                 Int       @id @default(autoincrement())
  nombre             String
  identificacion     String?
  cargo              String?
  estado             Boolean   @default(true)
  fechaCreacion      DateTime  @default(now())
  fechaActualizacion DateTime?
  fechaEliminacion   DateTime?

  usuarioCreadorId      String?
  usuarioCreador        Usuario? @relation("CustodioUsuarioCreador", fields: [usuarioCreadorId], references: [id])
  usuarioActualizadorId String?
  usuarioActualizador   Usuario? @relation("CustodioUsuarioActualizador", fields: [usuarioActualizadorId], references: [id])
  usuarioEliminadorId   String?
  usuarioEliminador     Usuario? @relation("CustodioUsuarioEliminador", fields: [usuarioEliminadorId], references: [id])

  bienes Bien[]
}

// Bien institucional (activo fijo).
model Bien {
  id                   Int      @id @default(autoincrement())
  codigo               String   @unique // placa institucional, ej. BN-YYYY-NNNN
  descripcion          String
  marca                String?
  modelo               String?
  serie                String?
  fechaAdquisicion     DateTime
  valorAdquisicion     Decimal  @db.Decimal(18, 2)
  fuenteFinanciamiento String?
  estadoConservacion   String   @default("bueno") // bueno | regular | malo
  ubicacion            String? // dependencia/oficina actual

  // Overrides opcionales sobre la categoría para la depreciación
  valorResidual         Decimal? @db.Decimal(18, 2)
  vidaUtilMesesOverride Int?

  // Baja de uso (lógica) — distinta de `estado` (borrado lógico)
  dadoDeBaja Boolean   @default(false)
  fechaBaja  DateTime?
  motivoBaja String? // obsolescencia | robo | venta | donacion | otro

  categoriaId Int
  categoria   CategoriaBien @relation(fields: [categoriaId], references: [id])
  custodioId  Int?
  custodio    Custodio?     @relation(fields: [custodioId], references: [id])

  movimientos    MovimientoBien[]
  depreciaciones DepreciacionBien[]

  estado             Boolean   @default(true)
  fechaCreacion      DateTime  @default(now())
  fechaActualizacion DateTime?
  fechaEliminacion   DateTime?

  usuarioCreadorId      String?
  usuarioCreador        Usuario? @relation("BienUsuarioCreador", fields: [usuarioCreadorId], references: [id])
  usuarioActualizadorId String?
  usuarioActualizador   Usuario? @relation("BienUsuarioActualizador", fields: [usuarioActualizadorId], references: [id])
  usuarioEliminadorId   String?
  usuarioEliminador     Usuario? @relation("BienUsuarioEliminador", fields: [usuarioEliminadorId], references: [id])

  @@index([categoriaId])
  @@index([custodioId])
}

// Historial unificado de movimientos por bien (INV-R8).
model MovimientoBien {
  id      Int      @id @default(autoincrement())
  bienId  Int
  bien    Bien     @relation(fields: [bienId], references: [id])
  tipo    String // alta | baja | reasignacion_custodio | cambio_ubicacion | depreciacion
  fecha   DateTime @default(now())
  detalle String?

  custodioAnteriorId Int?
  custodioNuevoId    Int?
  ubicacionAnterior  String?
  ubicacionNueva     String?
  documento          String? // path del acta de respaldo

  usuarioCreadorId String?
  usuarioCreador   Usuario? @relation("MovimientoBienUsuarioCreador", fields: [usuarioCreadorId], references: [id])

  @@index([bienId])
}

// Depreciación calculada por periodo (línea recta CGE 406-03) (INV-R7).
model DepreciacionBien {
  id                    Int      @id @default(autoincrement())
  bienId                Int
  bien                  Bien     @relation(fields: [bienId], references: [id])
  anio                  Int
  mes                   Int
  valorDepreciado       Decimal  @db.Decimal(18, 2) // del periodo
  depreciacionAcumulada Decimal  @db.Decimal(18, 2)
  valorEnLibros         Decimal  @db.Decimal(18, 2)
  fechaCalculo          DateTime @default(now())

  @@unique([bienId, anio, mes])
  @@index([bienId])
}
