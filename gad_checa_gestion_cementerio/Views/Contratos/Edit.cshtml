@model gad_checa_gestion_cementerio.Data.Contrato

@{
    ViewData["Title"] = "Editar Contrato";
    var responsablesContrato = ViewBag.ResponsablesContrato as List<SelectListItem> ?? new List<SelectListItem>();
    var responsablePrincipalId = ViewBag.ResponsablePrincipalId as int?;
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-primary text-white">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h4 class="mb-1 text-white">
                    <i class="ti ti-edit me-2"></i>Editar Contrato
                </h4>
                <p class="mb-0 text-white-50">@Model.NumeroSecuencial</p>
            </div>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-light">
                <i class="ti ti-arrow-left me-1"></i>Volver al detalle
            </a>
        </div>
    </div>

    <div class="card-body">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Número de contrato</label>
                    <input class="form-control bg-light" value="@Model.NumeroSecuencial" readonly />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Tipo</label>
                    <input class="form-control bg-light" value="@(Model.EsRenovacion ? "Renovación" : "Original")" readonly />
                </div>

                <div class="col-md-6">
                    <label asp-for="FechaInicio" class="form-label fw-semibold">Fecha de Inicio</label>
                    <input asp-for="FechaInicio" type="date" class="form-control" value="@Model.FechaInicio.ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="FechaInicio" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="FechaFin" class="form-label fw-semibold">Fecha de Fin</label>
                    <input asp-for="FechaFin" type="date" class="form-control" value="@Model.FechaFin.ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="FechaFin" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="MontoTotal" class="form-label fw-semibold">Monto Total</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="MontoTotal" type="text" inputmode="decimal" class="form-control" />
                    </div>
                    <span asp-validation-for="MontoTotal" class="text-danger small"></span>
                    <small class="text-muted d-block">Use coma para los decimales, por ejemplo 240,00</small>
                </div>
                <div class="col-md-12">
                    <label for="responsablePrincipalId" class="form-label fw-semibold">Responsable para el documento</label>
                    <select id="responsablePrincipalId" name="responsablePrincipalId" class="form-select">
                        @foreach (var responsable in responsablesContrato)
                        {
                            <option value="@responsable.Value" selected="@(responsablePrincipalId?.ToString() == responsable.Value)">
                                @responsable.Text
                            </option>
                        }
                    </select>
                    <small class="text-muted">Este responsable se usará como arrendatario al imprimir el contrato.</small>
                </div>

                <div class="col-md-12">
                    <label for="buscarResponsableEditar" class="form-label fw-semibold">Agregar responsable</label>
                    <div class="input-group">
                        <select id="buscarResponsableEditar" class="form-select"></select>
                        <button type="button" id="btnAgregarResponsableEditar" class="btn btn-success">
                            <i class="ti ti-plus me-1"></i>Agregar
                        </button>
                        <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#crearResponsableContratoModal">
                            <i class="ti ti-user-plus me-1"></i>Nuevo
                        </button>
                    </div>
                </div>

                <div class="col-md-12">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle" id="tablaResponsablesContrato">
                            <thead class="table-light">
                                <tr>
                                    <th>Responsable</th>
                                    <th>Identificación</th>
                                    <th>Teléfono</th>
                                    <th>Correo</th>
                                    <th class="text-end" style="width:110px;">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var responsable in Model.Responsables.OrderByDescending(r => r.FechaInicio).ThenByDescending(r => r.Id))
                                {
                                    <tr data-id="@responsable.Id">
                                        <td class="celda-nombre">@responsable.Nombres @responsable.Apellidos</td>
                                        <td class="celda-identificacion">@responsable.NumeroIdentificacion</td>
                                        <td class="celda-telefono">@responsable.Telefono</td>
                                        <td class="celda-email">@responsable.Email</td>
                                        <td class="text-end">
                                            <div class="btn-group btn-group-sm">
                                                <button type="button" class="btn btn-outline-primary btn-editar-responsable" title="Editar responsable">
                                                    <i class="ti ti-edit"></i>
                                                </button>
                                                <button type="button" class="btn btn-outline-danger btn-eliminar-responsable" title="Quitar del contrato">
                                                    <i class="ti ti-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="col-md-12">
                    <label asp-for="Observaciones" class="form-label fw-semibold">Observaciones</label>
                    <textarea asp-for="Observaciones" rows="4" class="form-control"></textarea>
                    <span asp-validation-for="Observaciones" class="text-danger small"></span>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                    <i class="ti ti-x me-1"></i>Cancelar
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="ti ti-device-floppy me-1"></i>Guardar cambios
                </button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="crearResponsableContratoModal" tabindex="-1" aria-labelledby="crearResponsableContratoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="crearResponsableContratoModalLabel">Crear Responsable</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-danger d-none" id="responsableEditErrors"></div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Nombres</label>
                        <input id="nuevoResponsableNombres" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Apellidos</label>
                        <input id="nuevoResponsableApellidos" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Tipo de Identificación</label>
                        <select id="nuevoResponsableTipoIdentificacion" class="form-select">
                            <option value="Cedula">Cedula</option>
                            <option value="RUC">RUC</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Número de Identificación</label>
                        <input id="nuevoResponsableNumeroIdentificacion" class="form-control" inputmode="numeric" maxlength="20" oninput="this.value = this.value.replace(/[^0-9]/g, '')" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Teléfono</label>
                        <input id="nuevoResponsableTelefono" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Correo</label>
                        <input id="nuevoResponsableEmail" type="email" class="form-control" required />
                    </div>
                    <div class="col-md-12">
                        <label class="form-label">Dirección</label>
                        <textarea id="nuevoResponsableDireccion" class="form-control" rows="2" required></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btnCrearResponsableContrato">Guardar responsable</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="editarResponsableContratoModal" tabindex="-1" aria-labelledby="editarResponsableContratoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editarResponsableContratoModalLabel">Editar Responsable</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-danger d-none" id="editarResponsableErrors"></div>
                <div class="alert alert-warning d-none" id="editarResponsableAviso"></div>
                <input type="hidden" id="editarResponsableId" />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Nombres</label>
                        <input id="editarResponsableNombres" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Apellidos</label>
                        <input id="editarResponsableApellidos" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Tipo de Identificación</label>
                        <select id="editarResponsableTipoIdentificacion" class="form-select">
                            <option value="Cedula">Cedula</option>
                            <option value="RUC">RUC</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Número de Identificación</label>
                        <input id="editarResponsableNumeroIdentificacion" class="form-control" inputmode="numeric" maxlength="20" oninput="this.value = this.value.replace(/[^0-9]/g, '')" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Teléfono</label>
                        <input id="editarResponsableTelefono" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Correo</label>
                        <input id="editarResponsableEmail" type="email" class="form-control" required />
                    </div>
                    <div class="col-md-12">
                        <label class="form-label">Dirección</label>
                        <textarea id="editarResponsableDireccion" class="form-control" rows="2" required></textarea>
                        <small class="text-muted">Se imprime en el contrato como domicilio del arrendatario.</small>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btnGuardarResponsableEditado">Guardar responsable</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        const contratoId = @Model.Id;
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

        function agregarResponsableASelect(responsable) {
            const option = new Option(responsable.text, responsable.id, true, true);
            $('#responsablePrincipalId').append(option).trigger('change');
        }

        function agregarResponsableATabla(responsable) {
            const tbody = document.querySelector('#tablaResponsablesContrato tbody');
            if (tbody.querySelector(`tr[data-id="${responsable.id}"]`)) return;

            const row = document.createElement('tr');
            row.dataset.id = responsable.id;
            row.innerHTML = `
                <td class="celda-nombre">${responsable.nombres} ${responsable.apellidos}</td>
                <td class="celda-identificacion">${responsable.identificacion}</td>
                <td class="celda-telefono">${responsable.telefono || ''}</td>
                <td class="celda-email">${responsable.email || ''}</td>
                <td class="text-end">
                    <div class="btn-group btn-group-sm">
                        <button type="button" class="btn btn-outline-primary btn-editar-responsable" title="Editar responsable">
                            <i class="ti ti-edit"></i>
                        </button>
                        <button type="button" class="btn btn-outline-danger btn-eliminar-responsable" title="Quitar del contrato">
                            <i class="ti ti-trash"></i>
                        </button>
                    </div>
                </td>`;
            tbody.prepend(row);
        }

        function actualizarFilaResponsable(responsable) {
            const row = document.querySelector(`#tablaResponsablesContrato tbody tr[data-id="${responsable.id}"]`);
            if (!row) return;

            row.querySelector('.celda-nombre').textContent = `${responsable.nombres} ${responsable.apellidos}`;
            row.querySelector('.celda-identificacion').textContent = responsable.identificacion;
            row.querySelector('.celda-telefono').textContent = responsable.telefono || '';
            row.querySelector('.celda-email').textContent = responsable.email || '';
        }

        function actualizarOpcionResponsable(responsable) {
            const option = document.querySelector(`#responsablePrincipalId option[value="${responsable.id}"]`);
            if (option) {
                option.textContent = responsable.text;
            }
        }

        function quitarResponsableDeVista(responsableId, nuevoPrincipalId) {
            document.querySelector(`#tablaResponsablesContrato tbody tr[data-id="${responsableId}"]`)?.remove();
            document.querySelector(`#responsablePrincipalId option[value="${responsableId}"]`)?.remove();

            if (nuevoPrincipalId) {
                $('#responsablePrincipalId').val(String(nuevoPrincipalId)).trigger('change');
            }
        }

        function marcarResponsablePrincipal(responsable) {
            agregarResponsableASelect(responsable);
            agregarResponsableATabla(responsable);
            $('#responsablePrincipalId').val(String(responsable.id)).trigger('change');
        }

        $('#buscarResponsableEditar').select2({
            placeholder: 'Buscar responsable por nombre o identificacion...',
            minimumInputLength: 2,
            ajax: {
                url: '@Url.Action("BuscarResponsableEdicion", "Contratos")',
                dataType: 'json',
                delay: 250,
                data: params => ({
                    contratoId,
                    searchTerm: params.term
                }),
                processResults: data => data
            }
        });

        document.getElementById('btnAgregarResponsableEditar').addEventListener('click', async () => {
            const responsableId = $('#buscarResponsableEditar').val();
            if (!responsableId) return;

            const formData = new FormData();
            formData.append('__RequestVerificationToken', token);
            formData.append('contratoId', contratoId);
            formData.append('responsableId', responsableId);

            const response = await fetch('@Url.Action("AgregarResponsableContrato", "Contratos")', {
                method: 'POST',
                body: formData
            });
            const data = await response.json();
            if (!data.success) {
                alert(data.message || 'No se pudo agregar el responsable.');
                return;
            }

            marcarResponsablePrincipal(data.responsable);
            $('#buscarResponsableEditar').val(null).trigger('change');
        });

        document.getElementById('btnCrearResponsableContrato').addEventListener('click', async () => {
            const errors = document.getElementById('responsableEditErrors');
            errors.classList.add('d-none');
            errors.textContent = '';

            const formData = new FormData();
            formData.append('__RequestVerificationToken', token);
            formData.append('contratoId', contratoId);
            formData.append('Nombres', document.getElementById('nuevoResponsableNombres').value);
            formData.append('Apellidos', document.getElementById('nuevoResponsableApellidos').value);
            formData.append('TipoIdentificacion', document.getElementById('nuevoResponsableTipoIdentificacion').value);
            formData.append('NumeroIdentificacion', document.getElementById('nuevoResponsableNumeroIdentificacion').value);
            formData.append('Telefono', document.getElementById('nuevoResponsableTelefono').value);
            formData.append('Email', document.getElementById('nuevoResponsableEmail').value);
            formData.append('Direccion', document.getElementById('nuevoResponsableDireccion').value);

            const response = await fetch('@Url.Action("CrearResponsableContrato", "Contratos")', {
                method: 'POST',
                body: formData
            });
            const data = await response.json();
            if (!data.success) {
                errors.textContent = data.message || 'No se pudo crear el responsable.';
                errors.classList.remove('d-none');
                return;
            }

            marcarResponsablePrincipal(data.responsable);
            bootstrap.Modal.getInstance(document.getElementById('crearResponsableContratoModal'))?.hide();
        });

        const modalEditarResponsable = new bootstrap.Modal(document.getElementById('editarResponsableContratoModal'));

        document.querySelector('#tablaResponsablesContrato tbody').addEventListener('click', async (evento) => {
            const fila = evento.target.closest('tr[data-id]');
            if (!fila) return;
            const responsableId = fila.dataset.id;

            if (evento.target.closest('.btn-editar-responsable')) {
                const url = '@Url.Action("ObtenerResponsableContrato", "Contratos")' +
                    `?contratoId=${contratoId}&responsableId=${responsableId}`;
                const data = await (await fetch(url)).json();
                if (!data.success) {
                    alert(data.message || 'No se pudo cargar el responsable.');
                    return;
                }

                const errores = document.getElementById('editarResponsableErrors');
                errores.classList.add('d-none');
                errores.textContent = '';

                const aviso = document.getElementById('editarResponsableAviso');
                if (data.otrosContratos > 0) {
                    aviso.textContent = `Esta persona también es responsable en ${data.otrosContratos} contrato(s) más. Los cambios se aplicarán en todos.`;
                    aviso.classList.remove('d-none');
                } else {
                    aviso.classList.add('d-none');
                    aviso.textContent = '';
                }

                const r = data.responsable;
                document.getElementById('editarResponsableId').value = r.id;
                document.getElementById('editarResponsableNombres').value = r.nombres || '';
                document.getElementById('editarResponsableApellidos').value = r.apellidos || '';
                document.getElementById('editarResponsableTipoIdentificacion').value = r.tipoIdentificacion || 'Cedula';
                document.getElementById('editarResponsableNumeroIdentificacion').value = r.numeroIdentificacion || '';
                document.getElementById('editarResponsableTelefono').value = r.telefono || '';
                document.getElementById('editarResponsableEmail').value = r.email || '';
                document.getElementById('editarResponsableDireccion').value = r.direccion || '';

                modalEditarResponsable.show();
                return;
            }

            if (evento.target.closest('.btn-eliminar-responsable')) {
                const filas = document.querySelectorAll('#tablaResponsablesContrato tbody tr[data-id]');
                if (filas.length <= 1) {
                    alert('El contrato debe conservar al menos un responsable.');
                    return;
                }

                const nombre = fila.querySelector('.celda-nombre').textContent.trim();
                if (!confirm(`¿Quitar a ${nombre} de este contrato?\n\nLa persona no se elimina del sistema, solo deja de ser responsable de este contrato.`)) {
                    return;
                }

                const formData = new FormData();
                formData.append('__RequestVerificationToken', token);
                formData.append('contratoId', contratoId);
                formData.append('responsableId', responsableId);

                const response = await fetch('@Url.Action("EliminarResponsableContrato", "Contratos")', {
                    method: 'POST',
                    body: formData
                });
                const data = await response.json();
                if (!data.success) {
                    alert(data.message || 'No se pudo quitar el responsable.');
                    return;
                }

                quitarResponsableDeVista(responsableId, data.responsablePrincipalId);
                if (data.reasignado) {
                    alert('El responsable quitado figuraba en el documento. El contrato pasó al responsable que quedó seleccionado.');
                }
            }
        });

        document.getElementById('btnGuardarResponsableEditado').addEventListener('click', async () => {
            const errores = document.getElementById('editarResponsableErrors');
            errores.classList.add('d-none');
            errores.textContent = '';

            const responsableId = document.getElementById('editarResponsableId').value;

            const formData = new FormData();
            formData.append('__RequestVerificationToken', token);
            formData.append('contratoId', contratoId);
            formData.append('responsableId', responsableId);
            formData.append('Nombres', document.getElementById('editarResponsableNombres').value);
            formData.append('Apellidos', document.getElementById('editarResponsableApellidos').value);
            formData.append('TipoIdentificacion', document.getElementById('editarResponsableTipoIdentificacion').value);
            formData.append('NumeroIdentificacion', document.getElementById('editarResponsableNumeroIdentificacion').value);
            formData.append('Telefono', document.getElementById('editarResponsableTelefono').value);
            formData.append('Email', document.getElementById('editarResponsableEmail').value);
            formData.append('Direccion', document.getElementById('editarResponsableDireccion').value);

            const response = await fetch('@Url.Action("EditarResponsableContrato", "Contratos")', {
                method: 'POST',
                body: formData
            });
            const data = await response.json();
            if (!data.success) {
                errores.textContent = data.message || 'No se pudo guardar el responsable.';
                errores.classList.remove('d-none');
                return;
            }

            actualizarFilaResponsable(data.responsable);
            actualizarOpcionResponsable(data.responsable);
            modalEditarResponsable.hide();
        });
    </script>
}
