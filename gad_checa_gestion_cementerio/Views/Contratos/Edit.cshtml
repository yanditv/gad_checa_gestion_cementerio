@model gad_checa_gestion_cementerio.Data.Contrato

@{
    ViewData["Title"] = "Editar Contrato";
    var responsablesContrato = ViewBag.ResponsablesContrato as List<SelectListItem> ?? new List<SelectListItem>();
    var responsablePrincipalId = ViewBag.ResponsablePrincipalId as int?;
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-primary text-white">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h4 class="mb-1 text-white">
                    <i class="ti ti-edit me-2"></i>Editar Contrato
                </h4>
                <p class="mb-0 text-white-50">@Model.NumeroSecuencial</p>
            </div>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-light">
                <i class="ti ti-arrow-left me-1"></i>Volver al detalle
            </a>
        </div>
    </div>

    <div class="card-body">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Número de contrato</label>
                    <input class="form-control bg-light" value="@Model.NumeroSecuencial" readonly />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Tipo</label>
                    <input class="form-control bg-light" value="@(Model.EsRenovacion ? "Renovación" : "Original")" readonly />
                </div>

                <div class="col-md-6">
                    <label asp-for="FechaInicio" class="form-label fw-semibold">Fecha de Inicio</label>
                    <input asp-for="FechaInicio" type="date" class="form-control" />
                    <span asp-validation-for="FechaInicio" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="FechaFin" class="form-label fw-semibold">Fecha de Fin</label>
                    <input asp-for="FechaFin" type="date" class="form-control" />
                    <span asp-validation-for="FechaFin" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="MontoTotal" class="form-label fw-semibold">Monto Total</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="MontoTotal" type="number" step="0.01" class="form-control" />
                    </div>
                    <span asp-validation-for="MontoTotal" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Estado</label>
                    <div class="form-check form-switch mt-2">
                        <input asp-for="Estado" class="form-check-input" type="checkbox" />
                        <label asp-for="Estado" class="form-check-label">Contrato activo</label>
                    </div>
                    <span asp-validation-for="Estado" class="text-danger small"></span>
                </div>

                <div class="col-md-12">
                    <label for="responsablePrincipalId" class="form-label fw-semibold">Responsable para el documento</label>
                    <select id="responsablePrincipalId" name="responsablePrincipalId" class="form-select">
                        @foreach (var responsable in responsablesContrato)
                        {
                            <option value="@responsable.Value" selected="@(responsablePrincipalId?.ToString() == responsable.Value)">
                                @responsable.Text
                            </option>
                        }
                    </select>
                    <small class="text-muted">Este responsable se usará como arrendatario al imprimir el contrato.</small>
                </div>

                <div class="col-md-12">
                    <label asp-for="Observaciones" class="form-label fw-semibold">Observaciones</label>
                    <textarea asp-for="Observaciones" rows="4" class="form-control"></textarea>
                    <span asp-validation-for="Observaciones" class="text-danger small"></span>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                    <i class="ti ti-x me-1"></i>Cancelar
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="ti ti-device-floppy me-1"></i>Guardar cambios
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
