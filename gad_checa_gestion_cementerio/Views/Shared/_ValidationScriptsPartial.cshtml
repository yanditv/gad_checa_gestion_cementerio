<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
<script>
    // La aplicacion atiende las peticiones con cultura es-ES, asi que los decimales se
    // muestran y se envian con coma ("240,00"). El validador de jQuery espera punto y
    // rechazaba esos valores con "The field ... must be a number".
    //
    // El punto NO se admite como separador decimal a proposito: el servidor lo interpreta
    // como separador de miles, de modo que "240.00" se guardaria como 24000.
    (function () {
        if (!window.jQuery || !window.jQuery.validator) {
            return;
        }

        // Acepta "240", "240,00" y "1.234,56"; rechaza "240.00"
        var patronDecimal = /^-?\d{1,3}(?:\.\d{3})*(?:,\d+)?$|^-?\d+(?:,\d+)?$/;

        function aNumero(valor) {
            return parseFloat(String(valor).replace(/\./g, '').replace(',', '.'));
        }

        jQuery.validator.methods.number = function (value, element) {
            return this.optional(element) || patronDecimal.test(value);
        };

        jQuery.validator.methods.range = function (value, element, param) {
            var numero = aNumero(value);
            return this.optional(element) || (!isNaN(numero) && numero >= param[0] && numero <= param[1]);
        };
    })();
</script>
