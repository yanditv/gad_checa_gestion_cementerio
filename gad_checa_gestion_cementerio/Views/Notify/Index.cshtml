@model IEnumerable<gad_checa_gestion_cementerio.Models.NotifyModel>

@{
    ViewData["Title"] = "Notificaciones";
}

<h2 class="mb-4">Centro de Notificaciones</h2>

@if (!Model.Any())
{
    <div class="alert alert-light border shadow-sm">
        <i class="ti ti-bell-off me-2"></i>No hay notificaciones nuevas.
    </div>
}
else
{
    @foreach (var item in Model)
    {
        <a href="@item.url" class="alert alert-@item.level shadow-sm d-flex align-items-start gap-3 mb-3 text-decoration-none" role="alert">
            <i class="@item.icon fs-4"></i>
            <div>
                <h5 class="mb-1">@item.title</h5>
                <p class="mb-1">@item.description</p>
                <span class="fw-semibold">Abrir</span>
            </div>
        </a>
    }
}
