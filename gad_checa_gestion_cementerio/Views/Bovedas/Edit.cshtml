@model gad_checa_gestion_cementerio.Data.Boveda

@{
    ViewData["Title"] = "Editar Bóveda";
    const int maximoDifuntos = 2;
    var contratosBoveda = ViewBag.ContratosBoveda as List<gad_checa_gestion_cementerio.Data.Contrato> ?? new List<gad_checa_gestion_cementerio.Data.Contrato>();
    var difuntosBoveda = ViewBag.DifuntosBoveda as List<gad_checa_gestion_cementerio.Data.Difunto> ?? new List<gad_checa_gestion_cementerio.Data.Difunto>();
    var contratosActivos = contratosBoveda.Count(c => c.Estado && c.FechaFin >= DateTime.Today);
    // Ocupación total de la bóveda: contratos vigentes + difuntos asignados sin contrato
    var ocupacionBoveda = contratosActivos + difuntosBoveda.Count;
    var tienePropietario = Model.PropietarioId.HasValue;
    // En bóvedas con propietario no se genera contrato: el difunto se registra directamente
    var permiteDifuntoSinContrato = tienePropietario && ocupacionBoveda < maximoDifuntos;
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-light border-0 py-3">
        <div class="d-flex align-items-center">
            <span class="me-3"><i class="ti ti-building-bank text-primary fs-3"></i></span>
            <div>
                <h4 class="mb-1 text-dark">@ViewData["Title"]</h4>
                <p class="mb-0 text-muted small">Modifique los datos de la bóveda según sea necesario. Los campos
                    marcados con * son obligatorios.</p>
            </div>
        </div>
    </div>
    <div class="card-body">
        @* Los botones de guardar viven al final de la página; se enlazan por id con form="..." *@
        <form asp-action="Edit" method="post" id="formEditarBoveda">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="FechaCreacion" />
            <input type="hidden" asp-for="UsuarioCreadorId" />
            <input type="hidden" asp-for="PisoId" />
            <div class="row g-4">
                <!-- Información de la Bóveda -->
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-header bg-light border-0 py-2">
                            <h6 class="mb-0"><i class="ti ti-info-circle me-2 text-primary"></i>Información de la Bóveda
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-6">
                                    <label class="form-label">Bloque</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="ti ti-building"></i></span>
                                        <input type="text" class="form-control" value="@ViewBag.BloqueNombre"
                                            readonly />
                                    </div>
                                </div>
                                <div class="col-6">
                                    <label class="form-label">Piso</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="ti ti-layers-difference"></i></span>
                                        <input type="text" class="form-control" value="@ViewBag.PisoNumero" readonly />
                                    </div>
                                </div>
                                <div class="col-6">
                                    <label asp-for="NumeroSecuencial" class="form-label">Número Secuencial *</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="ti ti-hash"></i></span>
                                        <input asp-for="NumeroSecuencial" class="form-control" required />
                                    </div>
                                    <span asp-validation-for="NumeroSecuencial" class="text-danger"></span>
                                </div>
                                <div class="col-6">
                                    <label class="form-label">Precio</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="ti ti-currency-dollar"></i></span>
                                        <input type="text" class="form-control" value="@ViewBag.Precio" readonly />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Información del Propietario -->
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-header bg-light border-0 py-2">
                            <h6 class="mb-0"><i class="ti ti-user me-2 text-primary"></i>Propietario</h6>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label class="form-label">Buscar Propietario</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="ti ti-search"></i></span>
                                    <select id="selectPropietario" class="form-select">
                                        <option></option>
                                    </select>
                                    <button type="button" class="btn btn-outline-success" id="btnCrearPropietario"
                                        title="Crear nuevo propietario">
                                        <i class="ti ti-plus"></i>
                                    </button>
                                </div>
                                <input type="hidden" asp-for="PropietarioId" id="propietarioId" />
                                <div id="propietarioInfo" class="mt-3 d-none">
                                    <div class="alert alert-info d-flex align-items-center mb-0">
                                        <i class="ti ti-user me-2 fs-4"></i>
                                        <div class="flex-grow-1">
                                            <h6 class="mb-0" id="propietarioNombre"></h6>
                                            <small class="text-muted" id="propietarioIdentificacion"></small>
                                            <div class="row mt-2">
                                                <div class="col-6">
                                                    <small class="text-muted d-block">Teléfono</small>
                                                    <span id="propietarioTelefono" class="fw-bold"></span>
                                                </div>
                                                <div class="col-6">
                                                    <small class="text-muted d-block">Email</small>
                                                    <span id="propietarioEmail" class="fw-bold"></span>
                                                </div>
                                                <div class="col-12 mt-2">
                                                    <small class="text-muted d-block">Dirección</small>
                                                    <span id="propietarioDireccion" class="fw-bold"></span>
                                                </div>
                                            </div>
                                        </div>
                                        <button type="button" class="btn btn-sm btn-outline-primary ms-2"
                                            id="btnCambiarPropietario">
                                            <i class="ti ti-refresh me-1"></i>Cambiar
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>

        <!-- Única sección para gestionar difuntos: los que entran por contrato y los que no -->
        <div class="card border-0 shadow-sm mt-4">
            <div class="card-header bg-light border-0 py-2">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <h6 class="mb-0"><i class="ti ti-user-heart me-2 text-primary"></i>Difuntos de la bóveda</h6>
                    <div class="d-flex gap-2">
                        @if (permiteDifuntoSinContrato)
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal"
                                data-bs-target="#asignarDifuntoModal">
                                <i class="ti ti-link me-1"></i>Asignar existente
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal"
                                data-bs-target="#registrarDifuntoModal">
                                <i class="ti ti-plus me-1"></i>Registrar difunto
                            </button>
                        }
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="alert alert-light border">
                    <i class="ti ti-info-circle me-2"></i>
                    @if (tienePropietario)
                    {
                        <text>Esta bóveda tiene propietario, por lo que los difuntos se registran directamente y no
                            requieren contrato.</text>
                    }
                    <strong>Ocupación: @ocupacionBoveda de @maximoDifuntos</strong>
                    &mdash; @contratosActivos por contrato vigente, @difuntosBoveda.Count sin contrato.
                </div>
                @if (!contratosBoveda.Any() && !difuntosBoveda.Any())
                {
                    <div class="text-muted small mb-0">
                        Esta bóveda todavía no tiene difuntos registrados.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Difunto</th>
                                    <th>Cédula</th>
                                    <th>Fallecimiento</th>
                                    <th>Origen</th>
                                    <th style="min-width: 380px;">Cambiar difunto</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var contrato in contratosBoveda)
                                {
                                    var activo = contrato.Estado && contrato.FechaFin >= DateTime.Today;
                                    var nombreActual = contrato.Difunto != null
                                    ? $"{contrato.Difunto.Nombres} {contrato.Difunto.Apellidos}"
                                    : "No registrado";
                                    <tr>
                                        <td class="fw-semibold">@nombreActual</td>
                                        <td>@(contrato.Difunto?.NumeroIdentificacion ?? "Sin identificación")</td>
                                        <td class="text-nowrap">
                                            @(contrato.Difunto?.FechaFallecimiento?.ToString("dd/MM/yyyy") ?? "-")
                                        </td>
                                        <td>
                                            <div class="fw-semibold">@contrato.NumeroSecuencial</div>
                                            <span
                                                class="badge bg-light-@(activo ? "success" : "secondary") text-@(activo ? "success" : "secondary")">
                                                @(activo ? "Activo" : "Histórico")
                                            </span>
                                        </td>
                                        <td>
                                            <div class="d-flex gap-2">
                                                <form asp-action="CambiarDifuntoContrato" method="post"
                                                    class="d-flex gap-2 flex-grow-1">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="bovedaId" value="@Model.Id" />
                                                    <input type="hidden" name="contratoId" value="@contrato.Id" />
                                                    <select name="difuntoId" class="form-select selectDifuntoLibre"
                                                        required></select>
                                                    <button type="submit" class="btn btn-outline-primary text-nowrap">
                                                        <i class="ti ti-device-floppy me-1"></i>Aplicar
                                                    </button>
                                                </form>
                                                <button type="button" class="btn btn-outline-success text-nowrap btnNuevoDifunto"
                                                    data-contrato-id="@contrato.Id" data-difunto-actual-id=""
                                                    data-actual="@nombreActual">
                                                    <i class="ti ti-plus me-1"></i>Nuevo
                                                </button>
                                            </div>
                                        </td>
                                        <td>
                                            @* Un contrato no puede quedarse sin difunto (Contrato.DifuntoId es
                                               obligatorio). Si el difunto sobra del todo, lo que se anula es el
                                               contrato, desde su propia pantalla. *@
                                            <a asp-controller="Contratos" asp-action="Details" asp-route-id="@contrato.Id"
                                                class="btn btn-outline-secondary text-nowrap"
                                                title="Para quitar este difunto hay que anular el contrato">
                                                <i class="ti ti-file-text me-1"></i>Ver contrato
                                            </a>
                                        </td>
                                    </tr>
                                }
                                @foreach (var difunto in difuntosBoveda)
                                {
                                    <tr>
                                        <td class="fw-semibold">@difunto.Nombres @difunto.Apellidos</td>
                                        <td>@(string.IsNullOrWhiteSpace(difunto.NumeroIdentificacion) ? "Sin identificación" : difunto.NumeroIdentificacion)</td>
                                        <td class="text-nowrap">
                                            @(difunto.FechaFallecimiento?.ToString("dd/MM/yyyy") ?? "-")
                                        </td>
                                        <td><span class="badge bg-light-info text-info">Sin contrato</span></td>
                                        <td>
                                            <div class="d-flex gap-2">
                                                <form asp-action="AsignarDifuntoBoveda" method="post"
                                                    class="d-flex gap-2 flex-grow-1">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="bovedaId" value="@Model.Id" />
                                                    <input type="hidden" name="difuntoActualId" value="@difunto.Id" />
                                                    <select name="difuntoId" class="form-select selectDifuntoLibre"
                                                        required></select>
                                                    <button type="submit" class="btn btn-outline-primary text-nowrap">
                                                        <i class="ti ti-device-floppy me-1"></i>Aplicar
                                                    </button>
                                                </form>
                                                <button type="button" class="btn btn-outline-success text-nowrap btnNuevoDifunto"
                                                    data-contrato-id="" data-difunto-actual-id="@difunto.Id"
                                                    data-actual="@difunto.Nombres @difunto.Apellidos">
                                                    <i class="ti ti-plus me-1"></i>Nuevo
                                                </button>
                                            </div>
                                        </td>
                                        <td>
                                            <form asp-action="QuitarDifuntoBoveda" method="post"
                                                onsubmit="return confirm('¿Quitar este difunto de la bóveda?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="bovedaId" value="@Model.Id" />
                                                <input type="hidden" name="difuntoId" value="@difunto.Id" />
                                                <button type="submit" class="btn btn-outline-danger text-nowrap">
                                                    <i class="ti ti-trash me-1"></i>Quitar
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        @if (contratosBoveda.Any())
        {
            <!-- Solo informativo: la gestión de difuntos vive en la sección de arriba -->
            <div class="card border-0 shadow-sm mt-4">
                <div class="card-header bg-light border-0 py-2">
                    <h6 class="mb-0"><i class="ti ti-history me-2 text-primary"></i>Contratos de la bóveda</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Contrato</th>
                                    <th>Periodo</th>
                                    <th>Estado</th>
                                    <th>Monto</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var contrato in contratosBoveda)
                                {
                                    var activo = contrato.Estado && contrato.FechaFin >= DateTime.Today;
                                    <tr>
                                        <td>
                                            <span class="fw-semibold">@contrato.NumeroSecuencial</span>
                                            @if (contrato.EsRenovacion)
                                            {
                                                <span class="badge bg-light-primary text-primary ms-1">Renovación</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="text-nowrap">@contrato.FechaInicio.ToString("dd/MM/yyyy")</span>
                                            <span class="text-muted">-</span>
                                            <span class="text-nowrap">@contrato.FechaFin.ToString("dd/MM/yyyy")</span>
                                        </td>
                                        <td>
                                            <span
                                                class="badge bg-light-@(activo ? "success" : "secondary") text-@(activo ? "success" : "secondary")">
                                                @(activo ? "Activo" : "Histórico")
                                            </span>
                                        </td>
                                        <td class="text-nowrap">$@contrato.MontoTotal.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        <!-- Botones de Acción: al final de la página, enlazados al formulario por id -->
        <div class="d-flex justify-content-end gap-2 mt-4">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="ti ti-x me-1"></i>Cancelar
            </a>
            <button type="submit" form="formEditarBoveda" class="btn btn-outline-primary">
                <i class="ti ti-device-floppy me-1"></i>Guardar Cambios
            </button>
        </div>
    </div>
</div>

@if (contratosBoveda.Any() || difuntosBoveda.Any())
{
    <!-- Modal: crea un difunto nuevo y lo pone en el lugar de otro, en un solo paso.
         Los campos ocultos los rellena el botón "Nuevo" de cada fila. -->
    <div class="modal fade" id="reemplazarDifuntoModal" tabindex="-1" aria-labelledby="reemplazarDifuntoModalLabel"
        aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <form asp-action="ReemplazarDifuntoConNuevo" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="bovedaId" value="@Model.Id" />
                    <input type="hidden" name="contratoId" id="reemplazarContratoId" />
                    <input type="hidden" name="difuntoActualId" id="reemplazarDifuntoActualId" />
                    <div class="modal-header bg-light">
                        <h5 class="modal-title" id="reemplazarDifuntoModalLabel">
                            <i class="ti ti-user-plus text-primary me-2"></i>Registrar difunto y reemplazar
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-warning border">
                            <i class="ti ti-alert-triangle me-2"></i>
                            Se creará este difunto y ocupará el lugar de
                            <strong id="reemplazarNombreActual">el difunto actual</strong>.
                            El anterior no se elimina: queda libre para asignarlo a otra bóveda.
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Cédula</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="ti ti-id"></i></span>
                                    <input type="text" name="NumeroIdentificacion" class="form-control" maxlength="20"
                                        required />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Nombres</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="ti ti-user"></i></span>
                                    <input type="text" name="Nombres" class="form-control" maxlength="100" required />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Apellidos</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="ti ti-user-check"></i></span>
                                    <input type="text" name="Apellidos" class="form-control" maxlength="100" required />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Fecha de nacimiento</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="ti ti-calendar-heart"></i></span>
                                    <input type="date" name="FechaNacimiento" class="form-control" required />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Fecha de defunción</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="ti ti-calendar-x"></i></span>
                                    <input type="date" name="FechaFallecimiento" class="form-control" required />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Descuento</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="ti ti-discount"></i></span>
                                    <select name="DescuentoId" class="form-select" asp-items="ViewBag.DescuentoId"
                                        required></select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                            <i class="ti ti-x me-1"></i>Cancelar
                        </button>
                        <button type="submit" class="btn btn-primary">
                            <i class="ti ti-device-floppy me-1"></i>Guardar y reemplazar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
@if (permiteDifuntoSinContrato)
{
    <!-- Modal: registrar un difunto nuevo directamente en la bóveda (sin contrato) -->
    <div class="modal fade" id="registrarDifuntoModal" tabindex="-1" aria-labelledby="registrarDifuntoModalLabel"
        aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <form asp-action="AgregarDifuntoBoveda" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="bovedaId" value="@Model.Id" />
                    <div class="modal-header bg-light">
                        <h5 class="modal-title" id="registrarDifuntoModalLabel">
                            <i class="ti ti-user-heart text-primary me-2"></i>Registrar difunto en la bóveda
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-light border">
                            El difunto quedará asociado directamente a esta bóveda con propietario. No se genera
                            contrato ni cuotas.
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Cédula</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="ti ti-id"></i></span>
                                    <input type="text" name="NumeroIdentificacion" class="form-control" maxlength="20"
                                        required />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Nombres</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="ti ti-user"></i></span>
                                    <input type="text" name="Nombres" class="form-control" maxlength="100" required />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Apellidos</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="ti ti-user-check"></i></span>
                                    <input type="text" name="Apellidos" class="form-control" maxlength="100" required />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Fecha de nacimiento</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="ti ti-calendar-heart"></i></span>
                                    <input type="date" name="FechaNacimiento" class="form-control" required />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Fecha de defunción</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="ti ti-calendar-x"></i></span>
                                    <input type="date" name="FechaFallecimiento" class="form-control" required />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Descuento</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="ti ti-discount"></i></span>
                                    <select name="DescuentoId" class="form-select" asp-items="ViewBag.DescuentoId"
                                        required></select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                            <i class="ti ti-x me-1"></i>Cancelar
                        </button>
                        <button type="submit" class="btn btn-primary">
                            <i class="ti ti-device-floppy me-1"></i>Guardar difunto
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal: asignar a la bóveda un difunto ya registrado -->
    <div class="modal fade" id="asignarDifuntoModal" tabindex="-1" aria-labelledby="asignarDifuntoModalLabel"
        aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form asp-action="AsignarDifuntoBoveda" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="bovedaId" value="@Model.Id" />
                    <div class="modal-header bg-light">
                        <h5 class="modal-title" id="asignarDifuntoModalLabel">
                            <i class="ti ti-link text-primary me-2"></i>Asignar difunto existente
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label fw-semibold">Difunto</label>
                        <select name="difuntoId" id="selectDifuntoExistente" class="form-select" required></select>
                        <div class="form-text">Solo se listan difuntos que no están en otra bóveda ni en un contrato.
                        </div>
                    </div>
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                            <i class="ti ti-x me-1"></i>Cancelar
                        </button>
                        <button type="submit" class="btn btn-primary">
                            <i class="ti ti-device-floppy me-1"></i>Asignar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
<!-- Modal de Creación de Propietario -->
<div class="modal fade" id="crearPropietarioModal" tabindex="-1" aria-labelledby="crearPropietarioModalLabel"
    aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="crearPropietarioModalLabel">
                    <i class="ti ti-plus me-2"></i>Crear Nuevo Propietario
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                    aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formPropietario">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Nombres *</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="ti ti-user"></i></span>
                                    <input type="text" class="form-control" name="Nombres" required>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Apellidos *</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="ti ti-user"></i></span>
                                    <input type="text" class="form-control" name="Apellidos" required>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Tipo de Identificación *</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="ti ti-id"></i></span>
                                    <select class="form-select" name="TipoIdentificacion" required>
                                        <option value="">Seleccione...</option>
                                        <option value="Cédula">Cédula</option>
                                        <option value="RUC">RUC</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Número de Identificación *</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="ti ti-hash"></i></span>
                                    <input type="text" class="form-control" name="NumeroIdentificacion" required>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Teléfono *</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="ti ti-phone"></i></span>
                                    <input type="text" class="form-control" name="Telefono" required>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Email *</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="ti ti-mail"></i></span>
                                    <input type="email" class="form-control" name="Email" required>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Dirección *</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="ti ti-map-pin"></i></span>
                            <input type="text" class="form-control" name="Direccion" required>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Catastro *</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="ti ti-file-description"></i></span>
                            <input type="text" class="form-control" name="Catastro" required>
                        </div>
                    </div>
                    <div class="text-end">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                            <i class="ti ti-x me-1"></i>Cancelar
                        </button>
                        <button type="button" class="btn btn-outline-success" id="btnGuardarPropietario">
                            <i class="ti ti-device-floppy me-1"></i>Guardar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {
            // Inicializar Select2
            $('#selectPropietario').select2({
                theme: 'bootstrap-5',
                placeholder: 'Buscar por identificación o nombre...',
                allowClear: true,
                ajax: {
                    url: '/Propietario/Buscar',
                    dataType: 'json',
                    delay: 250,
                    data: function (params) {
                        return {
                            searchTerm: params.term
                        };
                    },
                    processResults: function (data) {
                        return {
                            results: data.map(function (item) {
                                return {
                                    id: item.id,
                                    text: `${item.nombres} ${item.apellidos} - ${item.tipoIdentificacion}: ${item.numeroIdentificacion}`,
                                    nombres: item.nombres,
                                    apellidos: item.apellidos,
                                    tipoIdentificacion: item.tipoIdentificacion,
                                    numeroIdentificacion: item.numeroIdentificacion,
                                    telefono: item.telefono,
                                    email: item.email,
                                    direccion: item.direccion
                                };
                            })
                        };
                    },
                    cache: true
                },
                minimumInputLength: 3
            });
            // Búsqueda de difuntos que no están en otra bóveda ni en un contrato
            function opcionesDifuntosLibres(extra) {
                return $.extend({
                    theme: 'bootstrap-5',
                    placeholder: 'Buscar difunto disponible...',
                    allowClear: true,
                    ajax: {
                        url: '/Bovedas/BuscarDifuntos',
                        dataType: 'json',
                        delay: 250,
                        data: function (params) {
                            return {
                                searchTerm: params.term,
                                soloLibres: true
                            };
                        },
                        processResults: function (data) {
                            return {
                                results: data.map(function (item) {
                                    return {
                                        id: item.id,
                                        text: `${item.nombres} ${item.apellidos} - ${item.numeroIdentificacion || 'Sin identificación'}`
                                    };
                                })
                            };
                        },
                        cache: true
                    },
                    minimumInputLength: 3,
                    width: '100%'
                }, extra || {});
            }
            $('.selectDifuntoLibre').select2(opcionesDifuntosLibres());
            $('#selectDifuntoExistente').select2(opcionesDifuntosLibres({
                dropdownParent: $('#asignarDifuntoModal')
            }));
            // Botón "Nuevo" de cada fila: apunta el modal a esa fila y lo abre
            $('.btnNuevoDifunto').on('click', function () {
                $('#reemplazarContratoId').val($(this).data('contrato-id') || '');
                $('#reemplazarDifuntoActualId').val($(this).data('difunto-actual-id') || '');
                $('#reemplazarNombreActual').text($(this).data('actual') || 'el difunto actual');
                new bootstrap.Modal(document.getElementById('reemplazarDifuntoModal')).show();
            });
            // Inicializar modal
            var crearPropietarioModal = new bootstrap.Modal(document.getElementById('crearPropietarioModal'));
            // Evento al seleccionar un propietario
            $('#selectPropietario').on('select2:select', function (e) {
                var data = e.params.data;
                $('#propietarioId').val(data.id);
                $('#propietarioNombre').text(`${data.nombres} ${data.apellidos}`);
                $('#propietarioIdentificacion').text(`${data.tipoIdentificacion}: ${data.numeroIdentificacion}`);
                $('#propietarioTelefono').text(data.telefono || 'No especificado');
                $('#propietarioEmail').text(data.email || 'No especificado');
                $('#propietarioDireccion').text(data.direccion || 'No especificada');
                $('#propietarioInfo').removeClass('d-none');
            });
            // Evento para abrir modal de creación
            $('#btnCrearPropietario').on('click', function () {
                crearPropietarioModal.show();
            });
            // Evento para cambiar propietario
            $('#btnCambiarPropietario').on('click', function () {
                $('#propietarioId').val('');
                $('#propietarioNombre').text('');
                $('#propietarioIdentificacion').text('');
                $('#propietarioTelefono').text('');
                $('#propietarioEmail').text('');
                $('#propietarioDireccion').text('');
                $('#propietarioInfo').addClass('d-none');
                $('#selectPropietario').val(null).trigger('change');
            });
            // Evento para guardar nuevo propietario
            $('#btnGuardarPropietario').on('click', function () {
                var formData = $('#formPropietario').serialize();
                $.post('/Propietario/GuardarDesdeModal', formData)
                    .done(function (response) {
                        if (response.success) {
                            crearPropietarioModal.hide();
                            // Actualizar el select2 con el nuevo propietario
                            var newOption = new Option(
                                `${response.nombreCompleto} - ${response.tipoIdentificacion}: ${response.numeroIdentificacion}`,
                                response.id,
                                true,
                                true
                            );
                            $('#selectPropietario').append(newOption).trigger('change');
                            // Actualizar la información del propietario
                            $('#propietarioId').val(response.id);
                            $('#propietarioNombre').text(response.nombreCompleto);
                            $('#propietarioIdentificacion').text(`${response.tipoIdentificacion}: ${response.numeroIdentificacion}`);
                            $('#propietarioTelefono').text(response.telefono || 'No especificado');
                            $('#propietarioEmail').text(response.email || 'No especificado');
                            $('#propietarioDireccion').text(response.direccion || 'No especificada');
                            $('#propietarioInfo').removeClass('d-none');
                        } else {
                            alert('Error al guardar el propietario');
                        }
                    })
                    .fail(function () {
                        alert('Error al guardar el propietario');
                    });
            });
            // Cargar propietario actual si existe
            @if (Model.PropietarioId.HasValue)
            {
                // Se serializa a JSON para no romper el script con comillas ni codificar caracteres como "+"
                var propietarioJson = System.Text.Json.JsonSerializer.Serialize(new
                {
                    id = Model.PropietarioId.Value,
                    nombre = $"{Model.Propietario?.Nombres} {Model.Propietario?.Apellidos}".Trim(),
                    identificacion = $"{Model.Propietario?.TipoIdentificacion}: {Model.Propietario?.NumeroIdentificacion}",
                    telefono = Model.Propietario?.Telefono,
                    email = Model.Propietario?.Email,
                    direccion = Model.Propietario?.Direccion
                });
                <text>
                var propietarioActual = @Html.Raw(propietarioJson);
                var option = new Option(
                    `${propietarioActual.nombre} - ${propietarioActual.identificacion}`,
                    propietarioActual.id,
                    true,
                    true
                );
                $('#selectPropietario').append(option).trigger('change');
                $('#propietarioId').val(propietarioActual.id);
                $('#propietarioNombre').text(propietarioActual.nombre);
                $('#propietarioIdentificacion').text(propietarioActual.identificacion);
                $('#propietarioTelefono').text(propietarioActual.telefono || 'No especificado');
                $('#propietarioEmail').text(propietarioActual.email || 'No especificado');
                $('#propietarioDireccion').text(propietarioActual.direccion || 'No especificada');
                $('#propietarioInfo').removeClass('d-none');
                </text>
            }
        });
    </script>
}
